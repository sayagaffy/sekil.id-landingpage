{
  "name": "sekil-id-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "postbuild": "next-sitemap",
    "content:generate": "tsx scripts/generate-programmatic.ts",
    "content:generate:sample:personality": "tsx scripts/generate-programmatic.ts --type personality --slug intj",
    "content:generate:sample:career": "tsx scripts/generate-programmatic.ts --type career --slug data-scientist",
    "content:generate:sample:major": "tsx scripts/generate-programmatic.ts --type major --slug teknik-informatika",
    "content:generate:all:personality": "tsx scripts/generate-programmatic.ts --type personality --all",
    "content:generate:all:career": "tsx scripts/generate-programmatic.ts --type career --all",
    "content:generate:all:major": "tsx scripts/generate-programmatic.ts --type major --all",
    "db:migrate": "npx dotenv-cli -e .env.local -- prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "npx dotenv-cli -e .env.local -- tsx scripts/seed-db.ts",
    "admin:seed": "npx dotenv-cli -e .env.local -- tsx scripts/seed-admin.ts",
    "admin:reset-password": "npx dotenv-cli -e .env.local -- tsx scripts/reset-admin-password.ts",
    "content:validate": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@marsidev/react-turnstile": "^1.5.2",
    "@portabletext/react": "^3.2.4",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sanity/icons": "^2.11.8",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^3.99.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.469.0",
    "next": "14.2.35",
    "next-intl": "^3.26.3",
    "next-sanity": "^9.12.3",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.55.0",
    "resend": "^3.5.0",
    "sanity": "^3.99.0",
    "styled-components": "^6.4.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
}
